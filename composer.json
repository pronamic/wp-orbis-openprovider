{
	"name": "pronamic/wp-orbis-openprovider",
	"description": "The Orbis Openprovider plugin can check domains against Orbis subscriptions.",
	"license": "GPL-2.0-or-later",
	"type": "wordpress-plugin",
	"keywords": [
		"orbis",
		"openprovider",
		"wordpress",
		"plugin"
	],
	"authors": [
		{
			"name": "Pronamic",
			"email": "info@pronamic.eu",
			"homepage": "https://www.pronamic.eu/",
			"role": "Company"
		},
		{
			"name": "Remco Tolsma",
			"email": "info@remcotolsma.nl",
			"homepage": "https://www.remcotolsma.nl/",
			"role": "Developer"
		}
	],
	"support": {
		"email": "support@pronamic.eu",
		"issues": "https://github.com/pronamic/wp-orbis-openprovider/issues",
		"source": "https://github.com/pronamic/wp-orbis-openprovider"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"wp-slug": "orbis-openprovider"
	},
	"require-dev": {
		"pronamic/wp-coding-standards": "^2.1",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli-bundle": "*"
	},
	"scripts": {
		"build": [
			"rm -rf ./build/stage-1",
			"rm -rf ./build/orbis-openprovider",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --verbose --exclude-from=.distignore ./build/stage-1/ ./build/orbis-openprovider/",
			"vendor/bin/wp i18n make-pot ./build/orbis-openprovider/ --slug=orbis-openprovider",
			"vendor/bin/wp i18n make-mo ./build/orbis-openprovider/languages/",
			"vendor/bin/wp dist-archive ./build/orbis-openprovider/ --plugin-dirname=orbis-openprovider --force"
		],
		"dist-archive": "wp dist-archive . --plugin-dirname=orbis-openprovider",
		"make-pot": [
			"@build",
			"rsync --recursive --delete --verbose ./build/orbis-openprovider/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/orbis-openprovider.pot"
		],
		"phpcs": "vendor/bin/phpcs",
		"qa": [
			"@phpcs"
		]
	}
}
